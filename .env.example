# ---------------------------------------------------------------
# Ferma — muhit o'zgaruvchilari namunasi. Buni `.env` nomi bilan nusxalang.
# DIQQAT: haqiqiy parol/kalitlarni hech qachon Git'ga qo'shmang.
# ---------------------------------------------------------------

# Server porti
PORT=3001

# Ilovaga kirish paroli. Production (npm start) rejimida MAJBURIY.
# Mahalliy sinov uchun bo'sh qoldirish mumkin (ilova parolsiz ochiladi).
APP_PASSWORD=

# Kirish tokenlarini imzolash uchun uzun tasodifiy qator (kamida 32 belgi).
# Yaratish:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Ma'lumotlar bazasi ---------------------------------------
# 1) Production / ko'p qurilma: Supabase (PostgreSQL) ulanish qatori.
#    Supabase -> Project Settings -> Database -> Connection string (URI).
#    Bu qiymat faqat SERVERda turadi, brauzerga hech qachon chiqmaydi.
#DATABASE_URL=postgresql://postgres.xxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# 2) Mahalliy rejim (DATABASE_URL bo'sh bo'lsa): PostgreSQL (PGlite) shu papkada diskda saqlanadi.
#PGLITE_DIR=./data/pglite
